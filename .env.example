# اتركه فارغاً لاستخدام البيانات التجريبية المحلية
# مثال: /ords/zu_gates/gates-dashboard
VITE_ORDS_BASE_URL=

# Registration: separate ORDS service for each schema. Empty = labeled demo.
VITE_REGISTRATION_ORDS_BASE_URL=
VITE_TECHNICAL_REGISTRATION_ORDS_BASE_URL=
# Enable after installing and verifying graduates/ in both registration schemas.
VITE_REGISTRATION_GRADES_ENABLED=false
# Development only: preview REGIST summary/registration-days transfer trial handlers.
# Technical-college endpoints and production builds keep their normal paths.
VITE_REGISTRATION_TRANSFER_TRIAL=false
